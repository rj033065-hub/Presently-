# Presently Production Environment Configuration Template
# IMPORTANT: Never commit actual secret keys to git. Use hosting provider secret management.

# -----------------------------------------------------------------------------
# Frontend Configuration (Vercel)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://api.presently.app/api/v1
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_placeholder_clerk_publishable_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# -----------------------------------------------------------------------------
# Backend Configuration (Railway / Render)
# -----------------------------------------------------------------------------
ENVIRONMENT=production
PORT=8000
ALLOWED_ORIGINS=["https://presently.app","https://www.presently.app"]

# PostgreSQL Database Connection String (Neon)
DATABASE_URL=postgresql+asyncpg://user:password@ep-placeholder.region.aws.neon.tech/presently_db?sslmode=require

# Clerk Server-Side Secret Key
CLERK_SECRET_KEY=sk_live_placeholder_clerk_secret_key

# OpenAI API Key (Backend Only)
OPENAI_API_KEY=sk-proj-placeholder_openai_api_key

# Cloudinary Asset Uploads (Backend Only)
CLOUDINARY_CLOUD_NAME=placeholder_cloud_name
CLOUDINARY_API_KEY=placeholder_api_key
CLOUDINARY_API_SECRET=placeholder_api_secret
