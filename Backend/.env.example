# Backend Environment Configuration Template (Presently - AI Gift Recommendation Engine)
# IMPORTANT: DO NOT add real secret keys to this file. Use .env for actual values.

# Server Configuration
ENVIRONMENT=development  # development | staging | production
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000

# Database Configuration (Neon PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/presently_db

# Authentication (Clerk)
CLERK_SECRET_KEY=sk_test_placeholder_key
CLERK_ISSUER_URL=https://placeholder.clerk.accounts.dev

# OpenAI API Key (Backend Only - NEVER expose to frontend)
OPENAI_API_KEY=sk-placeholder_openai_api_key

# Cloudinary Credentials (Asset Uploads)
CLOUDINARY_CLOUD_NAME=placeholder_cloud
CLOUDINARY_API_KEY=placeholder_key
CLOUDINARY_API_SECRET=placeholder_secret
